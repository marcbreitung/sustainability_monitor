<T3DataStructure>
    <sheets>
        <sEnableLargestContentfulPaint>
            <ROOT>
                <sheetTitle>sustainability_monitor.db:flexforms_tab.settings.largestcontentfulpaint</sheetTitle>
                <type>array</type>
                <el>
                    <settings.enableLargestContentfulPaint>
                        <label>Enable Largest Contentful Paint</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.enableLargestContentfulPaint>
                    <settings.highlightLargestContentfulPaint>
                        <label>Highlight element</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.highlightLargestContentfulPaint>
                    <settings.highlightClassLargestContentfulPaint>
                        <label>Highlight CSS class</label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <default>highlighted</default>
                        </config>
                    </settings.highlightClassLargestContentfulPaint>
                </el>
            </ROOT>
        </sEnableLargestContentfulPaint>
        <sNumberOfRequests>
            <ROOT>
                <sheetTitle>sustainability_monitor.db:flexforms_tab.settings.numberofrequests</sheetTitle>
                <type>array</type>
                <el>
                    <settings.enableNumberOfRequests>
                        <label>Enable Number of Requests</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.enableNumberOfRequests>
                </el>
            </ROOT>
        </sNumberOfRequests>
    </sheets>
</T3DataStructure>