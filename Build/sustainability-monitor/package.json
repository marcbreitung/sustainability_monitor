{
  "name": "sustainability-monitor",
  "version": "0.0.1",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/sustainability-monitor/sustainability-monitor.esm.js",
  "exports": {
    ".": {
      "import": "./dist/sustainability-monitor/sustainability-monitor.esm.js",
      "require": "./dist/sustainability-monitor/sustainability-monitor.cjs.js"
    },
    "./sm-largest-contentful-paint": {
      "import": "./dist/components/sm-largest-contentful-paint.js",
      "types": "./dist/components/sm-largest-contentful-paint.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stenciljs/component-starter.git"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "test:e2e": "stencil-test --project browser",
    "test:spec": "stencil-test --project spec",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.52.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
